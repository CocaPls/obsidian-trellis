{
	"name": "trellis-plugin",
	"version": "0.5.0",
	"description": "Keep hierarchical tags and filename codes in sync in Obsidian, with a tag-based sidebar tree and link-safe bulk changes.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "node scripts/esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node --test",
		"verify:release": "node scripts/verify-release.mjs",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"tag",
		"rename",
		"trellis"
	],
	"author": "CocaPls",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CocaPls/obsidian-trellis.git"
	},
	"bugs": {
		"url": "https://github.com/CocaPls/obsidian-trellis/issues"
	},
	"homepage": "https://community.obsidian.md/plugins/trellis",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.59.1"
	},
	"allowScripts": {
		"esbuild@0.25.12": true
	}
}
